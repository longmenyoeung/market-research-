# Copy to backend/.env. No exchange credentials are used or accepted.
MCA_LOG_LEVEL=INFO
MCA_REQUEST_TIMEOUT_SECONDS=10
MCA_MAX_RETRIES=2
MCA_RETRY_BASE_SECONDS=0.5
MCA_MIN_REQUEST_INTERVAL_SECONDS=0.1
# Conservative rolling public REST request-weight budget. The adapter also
# lowers this when exchangeInfo publishes a smaller one-minute limit.
MCA_REQUEST_WEIGHT_PER_MINUTE=1200
MCA_SERVER_CLOCK_TTL_SECONDS=30
MCA_CALCULATION_CACHE_ENTRIES=1024
MCA_MAX_REQUEST_BODY_BYTES=524288
MCA_ALLOWED_HOSTS=["127.0.0.1","localhost","[::1]"]
MCA_RATE_LIMIT_COOLDOWN_SECONDS=60
MCA_BAN_COOLDOWN_SECONDS=86400
# Clamp any provider Retry-After header to this many seconds (default 24h).
MCA_RETRY_AFTER_MAX_SECONDS=86400
MCA_DISCOVERY_TTL_SECONDS=60
MCA_CANDLE_TTL_SECONDS=5
MCA_CACHE_MAX_ENTRIES=256
MCA_MAX_PENDING_REQUESTS=32
# Default database path is backend/data/market_data.db, independent of working directory.
# Use an absolute path when overriding it.
# MCA_DATABASE_PATH=C:/path/to/market_data.db
MCA_STREAM_STALE_SECONDS=15
MCA_STREAM_MAX_CONNECTIONS=10
MCA_STREAM_MAX_SUBSCRIBERS=50
MCA_STREAM_QUEUE_SIZE=32
MCA_STREAM_RECONNECT_SECONDS=1
# Trading cannot be enabled. Legacy MCA_TRADING_ENABLED=false is accepted;
# setting it to true prevents startup. No exchange execution code exists.
# Optional visible-ASCII key (16-128 chars). When configured, every /api route
# and candle WebSocket requires it. The browser provides a memory-only unlock
# screen and clears the key on reload/lock. This is not an exchange credential.
# Leave unset for the normal loopback-only dashboard. Never commit a key.
# MCA_API_KEY=replace-with-a-long-random-value
MCA_WEBSOCKET_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:5173","http://localhost:5173"]
